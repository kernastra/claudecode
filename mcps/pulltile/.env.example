# Multi-user mode (required in production). The server refuses to start
# without either Clerk or SKYBRIDGE_SINGLE_USER=1.

# Clerk Frontend API host, e.g. your-app.clerk.accounts.dev (Dashboard → API keys)
CLERK_FRONTEND_API=
# Clerk secret key, used server-side to read each user's GitHub token
CLERK_SECRET_KEY=

# GitHub App slug (github.com/apps/<slug>), used for the "Choose repositories" link
GITHUB_APP_SLUG=pulltile

# Signs merge confirmations. Optional for one instance (a random per-process
# secret is used); set a shared value when running more than one instance.
# MERGE_TOKEN_SECRET=

# Local dev only: single-user on your `gh` login (refused in production). Never
# tunnel the server publicly in this mode.
# SKYBRIDGE_SINGLE_USER=1
# Local dev only: overrides `gh auth token`
# GITHUB_TOKEN=
